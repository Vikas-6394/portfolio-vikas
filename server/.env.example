# =================================================================
# VIKAS MAURYA PORTFOLIO - SERVER ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port & Node Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and preview links)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas connection string)
# Leave blank or omit in development to automatically use the embedded memory/offline database!
MONGODB_URI=

# JWT Secrets for Authentication
# Generate high entropy 64+ char random strings for production
JWT_SECRET=super_secret_jwt_key_vikas_maurya_portfolio_2026_dev_mode
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_parser_secret_vikas_2026

# Admin Initial Setup Credentials (used during seed or initial CLI creation)
# Never expose or commit real production passwords
ADMIN_DEFAULT_EMAIL=admin@vikasmaurya.dev
ADMIN_DEFAULT_PASSWORD=ChangeMe123!@#
ADMIN_SETUP_SECRET=setup_admin_secret_key_2026

# Email Delivery (Nodemailer - SMTP / Gmail / Brevo / SendGrid / Postmark)
# Leave ENABLE_EMAIL=false during local testing to log simulated email notifications safely to console
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vikas Maurya" <noreply@vikasmaurya.dev>
CONTACT_RECIPIENT_EMAIL=vikasmaurya.work@gmail.com

# WhatsApp Direct Contact (International format without '+' e.g. 919876543210)
WHATSAPP_NUMBER=919876543210

# Cloudinary Storage (Optional - if omitted, safe local file upload in /uploads is used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
