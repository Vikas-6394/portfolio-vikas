# =================================================================
# VIKAS MAURYA PORTFOLIO — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Server & Network Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend API Endpoint (in client/.env)
# VITE_API_BASE_URL=http://localhost:5000/api

# MongoDB Atlas Database URI
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
# In local development: leave blank to automatically use the embedded in-memory database!
MONGODB_URI=

# JWT Authentication Secrets
# Generate high entropy 64+ character random strings for production
JWT_SECRET=super_secret_jwt_key_vikas_maurya_portfolio_2026_dev_mode
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_parser_secret_vikas_2026

# Administrator Initial Setup Credentials
ADMIN_DEFAULT_EMAIL=admin@vikasmaurya.dev
ADMIN_DEFAULT_PASSWORD=ChangeMe123!@#
ADMIN_SETUP_SECRET=setup_admin_secret_key_2026

# Email Delivery Configuration (Nodemailer - SMTP / Gmail / Brevo / SendGrid / Postmark)
# Leave ENABLE_EMAIL=false during local testing to log simulated email notifications safely to console
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vikas Maurya" <noreply@vikasmaurya.dev>
CONTACT_RECIPIENT_EMAIL=vikasmaurya.work@gmail.com

# Direct WhatsApp Click-to-Chat (International format without '+' sign e.g. 919876543210)
WHATSAPP_NUMBER=919876543210

# Cloudinary Storage for Uploads (Optional: if omitted, safe local file upload in server/uploads is used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
